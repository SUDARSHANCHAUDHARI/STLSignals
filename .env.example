# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
MOCK_MODE=true

# Database (SQLite — local file, no server needed)
DATABASE_URL=file:./stl-signals.db

# Reddit OAuth (get credentials at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=STLSignals/0.1 by SudarshanTechLabs
# Key for HMAC-SHA256 author hashes (e.g. `openssl rand -hex 32`). Unset = no author hash stored.
AUTHOR_HASH_SECRET=

# Public site URL (used for sitemap and RSS)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Ghost CMS (optional — only needed for "Publish to Ghost" button)
# Create an Admin API key at Ghost Admin → Integrations → Add custom integration
GHOST_URL=
GHOST_ADMIN_KEY=
