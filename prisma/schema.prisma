generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite: arrays stored as JSON strings; enums stored as plain String

model Source {
  id            String    @id @default(cuid())
  type          String    @default("reddit")
  name          String
  subreddit     String
  enabled       Boolean   @default(true)
  keywords      String    @default("[]")
  scanFrequency String    @default("daily")
  lastFetchedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  rawPosts RawPost[]
}

model RawPost {
  id             String   @id @default(cuid())
  sourceId       String
  externalId     String   @unique
  title          String
  url            String
  subreddit      String
  authorHash     String
  score          Int      @default(0)
  commentCount   Int      @default(0)
  createdUtc     DateTime
  permalink      String
  contentSnippet String
  fetchedAt      DateTime @default(now())

  source      Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  signalLinks SignalPost[]

  @@index([sourceId])
  @@index([subreddit])
  @@index([createdUtc])
}

model Signal {
  id             String    @id @default(cuid())
  title          String
  summary        String
  topic          String
  keywords       String    @default("[]")
  score          Int
  confidence     Float
  sourceCount    Int
  status         String    @default("new")
  researchPacket String?
  topicClusterId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  posts        SignalPost[]
  drafts       Draft[]
  topicCluster TopicCluster?    @relation(fields: [topicClusterId], references: [id])
  analytics    SignalAnalytics?
}

model SignalPost {
  id        String @id @default(cuid())
  signalId  String
  rawPostId String

  signal  Signal  @relation(fields: [signalId], references: [id], onDelete: Cascade)
  rawPost RawPost @relation(fields: [rawPostId], references: [id], onDelete: Cascade)

  @@unique([signalId, rawPostId])
}

model Draft {
  id              String    @id @default(cuid())
  signalId        String
  title           String
  slug            String    @unique
  excerpt         String
  contentMarkdown String
  seoTitle        String
  seoDescription  String
  status          String    @default("draft")
  version         Int       @default(1)
  editorialNotes  String?
  tags            String    @default("[]")
  faqs            String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  publishedAt     DateTime?

  signal     Signal             @relation(fields: [signalId], references: [id], onDelete: Cascade)
  repurposes ContentRepurpose[]
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  metadata   String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model TopicCluster {
  id          String   @id @default(cuid())
  topic       String   @unique
  label       String
  keywords    String   @default("[]")
  signalCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  signals Signal[]
}

model ContentRepurpose {
  id        String   @id @default(cuid())
  draftId   String
  platform  String
  content   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@unique([draftId, platform])
}

model SignalAnalytics {
  id         String   @id @default(cuid())
  signalId   String   @unique
  score      Int      @default(0)
  confidence Float    @default(0)
  embedding  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
}
