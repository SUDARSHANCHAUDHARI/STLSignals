generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SourceType {
  reddit
}

enum SignalStatus {
  new
  reviewed
  draft_created
  published
  ignored
}

enum DraftStatus {
  draft
  reviewing
  approved
  scheduled
  published
  archived
  rejected
}

model Source {
  id             String     @id @default(cuid())
  type           SourceType @default(reddit)
  name           String
  subreddit      String
  enabled        Boolean    @default(true)
  keywords       String[]
  scanFrequency  String     @default("daily")
  lastFetchedAt  DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  rawPosts RawPost[]
}

model RawPost {
  id             String   @id @default(cuid())
  sourceId       String
  externalId     String   @unique
  title          String
  url            String
  subreddit      String
  authorHash     String
  score          Int      @default(0)
  commentCount   Int      @default(0)
  createdUtc     DateTime
  permalink      String
  contentSnippet String   @db.VarChar(500)
  fetchedAt      DateTime @default(now())

  source      Source       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  signalLinks SignalPost[]

  @@index([sourceId])
  @@index([subreddit])
  @@index([createdUtc])
}

model Signal {
  id             String       @id @default(cuid())
  title          String
  summary        String
  topic          String
  keywords       String[]
  score          Int
  confidence     Float
  sourceCount    Int
  status         SignalStatus @default(new)
  researchPacket Json?
  topicClusterId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  posts        SignalPost[]
  drafts       Draft[]
  topicCluster TopicCluster?    @relation(fields: [topicClusterId], references: [id])
  analytics    SignalAnalytics?
}

model SignalPost {
  id        String @id @default(cuid())
  signalId  String
  rawPostId String

  signal  Signal  @relation(fields: [signalId], references: [id], onDelete: Cascade)
  rawPost RawPost @relation(fields: [rawPostId], references: [id], onDelete: Cascade)

  @@unique([signalId, rawPostId])
}

model Draft {
  id              String      @id @default(cuid())
  signalId        String
  title           String
  slug            String      @unique
  excerpt         String
  contentMarkdown String
  seoTitle        String
  seoDescription  String
  status          DraftStatus @default(draft)
  version         Int         @default(1)
  editorialNotes  String?
  tags            String[]    @default([])
  faqs            Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  publishedAt     DateTime?

  signal     Signal             @relation(fields: [signalId], references: [id], onDelete: Cascade)
  repurposes ContentRepurpose[]
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  metadata   Json
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

model TopicCluster {
  id          String   @id @default(cuid())
  topic       String   @unique
  label       String
  keywords    String[]
  signalCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  signals Signal[]
}

model ContentRepurpose {
  id        String   @id @default(cuid())
  draftId   String
  platform  String
  content   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@unique([draftId, platform])
}

model SignalAnalytics {
  id         String   @id @default(cuid())
  signalId   String   @unique
  score      Int      @default(0)
  confidence Float    @default(0)
  embedding  Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
}
